取り込む "hajimu_gui" として GUI
変数 アプリ = GUI.アプリ作成("タスク出力・進捗検査", 640, 400)
変数 成功 = -1
変数 失敗 = -1
変数 途中確認 = 偽
変数 上限確認 = 偽
変数 通知数 = 0
GUI.描画ループ(アプリ, 関数():
    もし 成功 == -1 なら
        成功 = GUI.非同期実行({"実行ファイル": "/bin/sh", "引数": ["-c", "printf '日本語\\n'; printf '注意\\n' >&2; printf '25.5\\n' >&3; sleep 1; printf '70\\n' >&3; sleep 0.1"], "出力取得": 真, "進捗取得": 真}, 無)
        失敗 = GUI.非同期実行({"実行ファイル": "/bin/sh", "引数": ["-c", "printf '100\\n' >&3; printf 'denied' >&2; sleep 0.7; exit 7"], "出力取得": 真, "進捗取得": 真}, 無)
        表明(成功 > 0 かつ 失敗 > 0, "プロセス起動に失敗しました")
        表明(GUI.非同期実行({"実行ファイル": "/bin/sh", "引数": [], "出力取得": 1}, 無) == -1, "不正な出力設定を受理しました")
    終わり
    GUI.テキスト("GUIフレーム " + 文字列化(GUI.フレーム数()))
    変数 進捗 = GUI.タスク進捗(成功)
    もし 進捗 == 25.5 または 進捗 == 70 なら
        途中確認 = 真
    終わり
    もし GUI.タスク進捗(失敗) == 99 なら
        上限確認 = 真
    終わり
    GUI.タスク通知(成功, 関数(結果):
        通知数 = 通知数 + 1
        表明(結果["状態"] == "成功" かつ 結果["進捗"] == 100, "成功通知が不正です")
    終わり)
    変数 出力 = GUI.タスク出力(成功)
    変数 エラー = GUI.タスク出力(失敗)
    もし 通知数 > 0 かつ 出力["読取完了"] かつ エラー["読取完了"] なら
        表明(途中確認 かつ 上限確認 かつ 通知数 == 1, "途中進捗か一回通知を確認できません")
        表明(出力["標準出力"] == "日本語\n" かつ 出力["標準エラー"] == "注意\n", "出力の分離か日本語が壊れました")
        表明(出力["標準出力バイト数"] == 10 かつ 出力["取得有効"], "出力情報が不正です")
        表明(エラー["標準エラー"] == "denied" かつ GUI.タスク進捗(失敗) == -1, "失敗を成功扱いにしました")
        表明(GUI.タスク出力(成功 + 0.5)["有効"] == 偽, "小数IDを受理しました")
        表明(GUI.タスク解放(成功) かつ GUI.タスク解放(失敗), "タスク解放に失敗しました")
        表明(GUI.タスク出力(成功)["有効"] == 偽, "解放後の出力が有効です")
        GUI.アプリ終了(アプリ)
    終わり
    表明(GUI.フレーム数() < 300, "タスク出力を待ち続けています")
終わり)
表示("async output/progress API passed")
