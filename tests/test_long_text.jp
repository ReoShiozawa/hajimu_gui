取り込む "hajimu_gui" として GUI

変数 本文 = ""
_i を 1 から 400 繰り返す
    本文 = 本文 + "長い日本語のセリフを編集します。\n"
終わり
変数 元の本文 = 本文
変数 アプリ = GUI.アプリ作成("長文の編集確認", 800, 600)
変数 撮影先 = 環境変数("GUI_LONG_TEXT_CAPTURE")
変数 撮影済み = 偽
GUI.テーマ設定("ライト")
GUI.描画ループ(アプリ, 関数():
    本文 = GUI.テキストエリア("本文", 本文, 8)
    表明(本文 == 元の本文, "長い本文が表示だけで欠落しました")
    もし GUI.フレーム数() >= 3 なら
        もし 撮影先 != 無 かつ 撮影先 != "" かつ 撮影済み == 偽 なら
            GUI.スクリーンショット(撮影先)
            撮影済み = 真
        それ以外
            GUI.アプリ終了(アプリ)
        終わり
    終わり
終わり)
GUI.アプリ終了(アプリ)
表示("long text API passed")
