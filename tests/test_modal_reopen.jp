取り込む "hajimu_gui" として GUI
変数 アプリ = GUI.アプリ作成("フォームの寿命", 640, 400)
変数 段階 = 0
GUI.描画ループ(アプリ, 関数():
    段階 = 段階 + 1
    もし 段階 == 2 なら
        GUI.モーダル予約(["親", "子"])
        表明(GUI.ダイアログ開始("子", 真), "子を開けません")
        表明(GUI.テキスト入力("値", "子の値") == "子の値", "親と混線しました")
        GUI.ダイアログ終了()
    それ以外もし 段階 == 4 なら
        GUI.モーダル予約([])
    それ以外もし 段階 <= 5 なら
        GUI.モーダル予約(["親"])
        表明(GUI.ダイアログ開始("親", 真, {"幅": 600, "高さ": 340}), "親を開けません")
        変数 初期値 = "最初の値"
        もし 段階 == 3 なら 初期値 = "覆われた親への未採用初期値" 終わり
        もし 段階 == 5 なら 初期値 = "開き直した値" 終わり
        変数 結果 = GUI.テキスト入力("値", 初期値)
        もし 段階 == 3 なら
            表明(結果 == "最初の値", "覆われた親の編集状態を破棄しました")
            表明(GUI.テキストカーソル位置("値") == 1, "親の編集位置を保持しません")
        それ以外
            表明(結果 == 初期値, "閉じたフォームの古い値が残っています")
            GUI.テキストカーソル位置("値", 1)
        終わり
        GUI.ダイアログ終了()
    それ以外
        GUI.モーダル予約([])
        GUI.アプリ終了(アプリ)
    終わり
終わり)
GUI.アプリ終了(アプリ)
表示("modal reopen API passed")
