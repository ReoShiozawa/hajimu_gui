取り込む "hajimu_gui" として GUI
変数 アプリ = GUI.アプリ作成("非同期取消検査", 640, 400)
変数 タスク = -1
変数 要求済み = 偽
変数 通知数 = 0
GUI.描画ループ(アプリ, 関数():
    もし タスク == -1 なら
        タスク = GUI.非同期実行({"実行ファイル": "/bin/sh", "引数": ["-c", "printf 'ready'; printf 'before-cancel' >&2; printf '40\\n' >&3; exec sleep 10"], "出力取得": 真, "進捗取得": 真}, 無)
        表明(タスク > 0, "タスクを起動できません")
    終わり
    GUI.テキスト("取消検査フレーム " + 文字列化(GUI.フレーム数()))
    変数 出力 = GUI.タスク出力(タスク)
    もし 要求済み == 偽 かつ 出力["標準出力"] == "ready" かつ GUI.フレーム数() > 3 なら
        表明(GUI.タスクキャンセル(タスク), "取消を要求できません")
        表明(GUI.タスクキャンセル(タスク) == 偽, "同じ取消要求を再送しました")
        表明(GUI.タスク進捗(タスク) == -1, "取消中を成功進捗にしました")
        要求済み = 真
    終わり
    GUI.タスク通知(タスク, 関数(結果):
        通知数 = 通知数 + 1
        表明(要求済み かつ 結果["状態"] == "取消", "回収前か取消前に完了通知しました")
        表明(結果["終了コード"] == 137 かつ 結果["進捗"] == -1, "取消結果が不正です")
    終わり)
    もし 通知数 > 0 かつ GUI.タスク出力(タスク)["読取終了"] なら
        表明(通知数 == 1, "取消完了を重複通知しました")
        表明(GUI.タスク出力(タスク)["標準エラー"] == "before-cancel", "取消前のログを失いました")
        表明(GUI.タスク解放(タスク), "回収済みタスクを解放できません")
        GUI.アプリ終了(アプリ)
    終わり
    表明(GUI.フレーム数() < 300, "取消を待ち続けています")
終わり)
表明(要求済み かつ 通知数 == 1, "取消の検査が完了していません")
表示("async cancellation API passed")
