取り込む "hajimu_gui" として GUI
変数 履歴 = GUI.履歴作成("初期", 3, 1000)
表明(履歴 > 0 かつ GUI.履歴状態(履歴)["保存済み"], "初期履歴が不正です")
表明(GUI.履歴保存点(履歴, 偽) かつ GUI.履歴状態(履歴)["保存済み"] == 偽, "復旧状態を未保存にできません")
表明(GUI.履歴保存点(履歴), "初期保存点を設定できません")
表明(GUI.履歴追加(履歴, "入", "入力", "text"), "追加できません")
表明(GUI.履歴追加(履歴, "入力", "入力", "text"), "統合できません")
表明(GUI.履歴状態(履歴)["件数"] == 2, "連続入力が統合されていません")
表明(GUI.履歴戻す(履歴) == "初期", "統合した操作を戻せません")
表明(GUI.履歴やり直す(履歴) == "入力", "やり直せません")
表明(GUI.履歴保存点(履歴), "保存点を設定できません")
表明(GUI.履歴まとめ開始(履歴, "複合操作"), "まとめを開始できません")
GUI.履歴追加(履歴, "途中1")
GUI.履歴追加(履歴, "途中2")
表明(GUI.履歴現在(履歴) == "途中2", "まとめ中の現在値が不正です")
表明(GUI.履歴戻す(履歴) == 無, "まとめ中に戻しました")
表明(GUI.履歴まとめ終了(履歴, 真), "まとめを確定できません")
表明(GUI.履歴戻す(履歴) == "入力" かつ GUI.履歴状態(履歴)["保存済み"], "まとめ前の保存点へ戻りません")
表明(GUI.履歴まとめ開始(履歴, "取消"), "まとめを開始できません")
GUI.履歴追加(履歴, "破棄")
表明(GUI.履歴まとめ終了(履歴, 偽) かつ GUI.履歴現在(履歴) == "入力", "取消が不正です")
表明(GUI.履歴追加(履歴, "分岐"), "分岐を作れません")
表明(GUI.履歴やり直す(履歴) == 無, "分岐前のRedoが残っています")
表明(GUI.履歴破棄(履歴), "破棄できません")
表明(GUI.履歴現在(履歴) == 無 かつ GUI.履歴破棄(履歴) == 偽, "破棄後のハンドルを受け付けました")
表明(GUI.履歴現在(1.5) == 無, "整数以外のハンドルを受け付けました")
変数 一覧 = []
_i を 1 から 16 繰り返す
    変数 _id = GUI.履歴作成("初期")
    表明(_id > 0, "上限前に作成できません")
    追加(一覧, _id)
終わり
表明(GUI.履歴作成("超過") == -1, "モデル数の上限がありません")
各 _id を 一覧 の中:
    表明(GUI.履歴破棄(_id), "履歴を破棄できません")
終わり
表示("history API tests passed")
