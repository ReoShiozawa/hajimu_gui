取り込む "hajimu_gui" として GUI

// 未初期化・描画外の早期returnでも、引数を借用したまま返さない。
_i を 1 から 1000 繰り返す
    変数 入力値 = GUI.テキスト入力("入力", "保持", {"プレースホルダー": "例"})
    表明(入力値 == "保持", "描画外の入力値が解放されています")
    表明(GUI.テキストエリア("本文", "長文の保持", 4) == "長文の保持", "描画外の本文が解放されています")
    変数 選択値 = GUI.コンボボックス("選択", ["項目A", "項目B"], "項目A")
    表明(選択値 == "項目A", "描画外の選択値が解放されています")
    表明(GUI.ラジオボタン("選択肢", "グループ", "保持") == "保持", "描画外のラジオ値が解放されています")
    表明(GUI.リスト("一覧", ["項目A", "項目B"], 0) == -1, "描画外の一覧の値が不正です")
終わり
表示("control argument ownership passed")
