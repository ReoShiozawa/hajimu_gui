取り込む "hajimu_gui" として GUI
変数 仕様 = [{"最小": 100, "最大": 150, "伸縮": 1}, {"最小": 100, "最大": 1000, "伸縮": 3}]
変数 幅 = GUI.制約幅(仕様, 408, 8)
表明(長さ(幅) == 2 かつ 幅[0] == 150 かつ 幅[1] == 250, "上限付きの配分が不正です")
表明(長さ(GUI.制約幅(仕様, 207, 8)) == 0, "最小幅を破って横並びにしています")
表明(長さ(GUI.制約幅([{"最小": 100, "最大": 99}], 500)) == 0, "矛盾した制約を受け付けました")
表明(長さ(GUI.制約幅([{"伸縮": -1}], 500)) == 0, "負の伸縮を受け付けました")
表明(長さ(GUI.制約幅([{"最小": "100"}], 500)) == 0, "誤った型を受け付けました")
変数 固定 = GUI.制約幅([{"最小": 120, "伸縮": 0}, {"最小": 80}], 408)
表明(固定[0] == 120 かつ 固定[1] == 280, "固定列が伸縮しました")
表示("layout API tests passed")
