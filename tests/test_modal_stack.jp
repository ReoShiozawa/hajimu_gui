取り込む "hajimu_gui" として GUI
変数 パス = 環境変数("GUI_MODAL_CAPTURE")
表明(パス != 無 かつ パス != "", "キャプチャ先が必要です")
変数 アプリ = GUI.アプリ作成("モーダルの入力と配置", 800, 600)
GUI.テーマ設定("ライト")
変数 保存済み = 偽
GUI.描画ループ(アプリ, 関数():
    表明(GUI.モーダル予約(["作品設定", "追加の確認"]), "二段の予約ができません")
    表明(GUI.モーダル予約(["作品設定", "作品設定"]) == 偽, "重複名を受理しました")
    変数 一覧 = GUI.モーダルスタック()
    表明(長さ(一覧) == 2 かつ 一覧[0] == "作品設定" かつ 一覧[1] == "追加の確認", "予約順序が違います")
    追加(一覧, "呼出元だけの値")
    表明(長さ(GUI.モーダルスタック()) == 2, "返却配列が内部状態を変更しました")
    GUI.子ウィンドウ開始("背景の小さい領域", 120, 70, 真)
    表明(GUI.ボタン("背後の操作") == 偽, "背景が操作されました")
    表明(GUI.ダイアログ開始("作品設定", 真), "親を描画できません")
    表明(GUI.テキスト入力("名前", "親の内容") == "親の内容", "親の入力状態が混線しました")
    表明(GUI.テキストカーソル位置("名前", 1) == 1, "親の範囲がありません")
    表明(GUI.ダイアログ開始("追加の確認", 真), "子を描画できません")
    表明(GUI.テキスト入力("名前", "子の内容") == "子の内容", "子の入力状態が混線しました")
    表明(GUI.テキストカーソル位置("名前", 2) == 2, "子の範囲がありません")
    GUI.ボタン("確認")
    表明(GUI.ダイアログ終了(), "子の範囲を復元できません")
    表明(GUI.テキストカーソル位置("名前") == 1, "親の入力位置に戻りません")
    表明(GUI.ダイアログ終了(), "親の範囲を復元できません")
    表明(GUI.ダイアログ終了() == 偽, "過剰な終了を受理しました")
    表明(GUI.ダイアログ開始("未予約", 真) == 偽, "未予約の層を描画しました")
    GUI.子ウィンドウ終了()
    もし 保存済み かつ ファイル存在(パス) なら
        GUI.モーダル予約([])
        GUI.アプリ終了(アプリ)
    それ以外もし GUI.フレーム数() > 2 かつ 保存済み == 偽 なら
        GUI.スクリーンショット(パス)
        保存済み = 真
    終わり
終わり)
GUI.アプリ終了(アプリ)
表示("modal stack API passed")
