取り込む "hajimu_gui" として GUI
変数 アプリ = GUI.アプリ作成("選択部品の配置", 640, 480)
GUI.テーマ設定("ライト")
GUI.フォントサイズ(22)
変数 パス = 環境変数("GUI_TOGGLE_CAPTURE")
変数 撮影済み = 偽
GUI.描画ループ(アプリ, 関数():
    GUI.子ウィンドウ開始("choices", 300, 420)
    GUI.テキスト("長いラベルの選択部品")
    変数 領域 = GUI.ウィジェット矩形()
    変数 前の下端 = 領域["y"] + 領域["高さ"]
    種類 を 0 から 2 繰り返す
        もし 種類 == 0 なら GUI.チェックボックス("このシーンでは音楽を続けて再生する", 真) 終わり
        もし 種類 == 1 なら GUI.ラジオボタン("選択した章の最初から再生する", "開始位置", "") 終わり
        もし 種類 == 2 なら GUI.スライダー("背景で再生する音楽の音量", 50, 0, 100) 終わり
        変数 部品 = GUI.ウィジェット矩形()
        表明(部品["x"] >= 領域["x"] かつ 部品["x"] + 部品["幅"] <= 領域["x"] + 領域["幅"], "選択部品が親幅からはみ出しました")
        表明(部品["y"] >= 前の下端, "選択部品が前の部品に重なりました")
        前の下端 = 部品["y"] + 部品["高さ"]
    終わり
    GUI.子ウィンドウ終了()
    もし GUI.フレーム数() >= 3 なら
        もし パス != 無 かつ パス != "" かつ 撮影済み == 偽 なら
            GUI.スクリーンショット(パス)
            撮影済み = 真
        それ以外
            GUI.アプリ終了(アプリ)
        終わり
    終わり
終わり)
GUI.アプリ終了(アプリ)
表示("toggle/slider layout API passed")
