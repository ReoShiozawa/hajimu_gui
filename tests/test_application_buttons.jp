// 狭い親領域・補助ボタン・明示高さ・日本語省略の描画回帰用。
取り込む "hajimu_gui" として GUI
変数 アプリ = GUI.アプリ作成("アプリ用ボタンの回帰テスト", 640, 600)
GUI.テーマ設定("ライト")
変数 保存済み = 偽
GUI.描画ループ(アプリ, 関数():
    GUI.子ウィンドウ開始("narrow", 260, 540, 真)
    GUI.ボタン("新しい作品を作る", {"幅": 320, "高さ": 44})
    GUI.ボタン("保存した作品を開く", {"幅": 320, "高さ": 44, "補助": 真})
    GUI.省略テキスト("とても長い作品名の表示を確認するための日本語文字列", 160)
    GUI.省略テキスト("/Users/example/Documents/projects/very-long-project-name", 160)
    GUI.省略テキスト("幅ゼロ", 0)
    GUI.省略テキスト("最初の行\n表示されない二行目", 160)
    GUI.ボタン("無効な操作", {"有効": 偽})
    GUI.ボタン("狭い領域のとても長い操作名", {"幅": 110})
    GUI.一覧項目("recent", "空のポスト", "/Users/example/Documents/long-project-path", 真)
    GUI.子ウィンドウ終了()
    もし 保存済み かつ ファイル存在("/tmp/hajimu_gui_application_buttons.ppm") なら
        GUI.アプリ終了(アプリ)
    それ以外もし GUI.フレーム数() > 2 かつ 保存済み == 偽 なら
        GUI.スクリーンショット("/tmp/hajimu_gui_application_buttons.ppm")
        保存済み = 真
    終わり
終わり)
