取り込む "hajimu_gui" として GUI
変数 アプリ = GUI.アプリ作成("入力フォームの折返し", 640, 480)
GUI.テーマ設定("ライト")
GUI.フォントサイズ(24)
変数 パス = 環境変数("GUI_FORM_CAPTURE")
変数 撮影済み = 偽
GUI.描画ループ(アプリ, 関数():
    GUI.子ウィンドウ開始("form", 280, 420)
    GUI.テキスト("入力フォーム")
    変数 領域 = GUI.ウィジェット矩形()
    変数 前の下端 = -1
    種類 を 0 から 3 繰り返す
        もし 種類 == 0 なら GUI.テキスト入力("作品につける長い名前", "空のポスト") 終わり
        もし 種類 == 1 なら GUI.パスワード入力("共有用パスワード", "秘密の値") 終わり
        もし 種類 == 2 なら GUI.数値入力("文章を表示する速度", 2, 1, 10) 終わり
        もし 種類 == 3 なら GUI.コンボボックス("最初に開くシーン", ["長い名前のシーン", "次の場面"], "長い名前のシーン") 終わり
        変数 欄 = GUI.ウィジェット矩形()
        表明(欄["x"] >= 領域["x"] かつ 欄["x"] + 欄["幅"] <= 領域["x"] + 領域["幅"], "入力欄が親の横幅を超えました")
        表明(欄["y"] >= 前の下端, "前の入力と重なりました")
        前の下端 = 欄["y"] + 欄["高さ"]
    終わり
    GUI.子ウィンドウ終了()
    もし GUI.フレーム数() >= 3 なら
        もし パス != 無 かつ パス != "" かつ 撮影済み == 偽 なら
            GUI.スクリーンショット(パス)
            撮影済み = 真
        それ以外
            GUI.アプリ終了(アプリ)
        終わり
    終わり
終わり)
GUI.アプリ終了(アプリ)
表示("responsive field API passed")
