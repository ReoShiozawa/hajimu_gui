// 公開API経由でGUIを動かしたまま失敗と完了通知を確認する。
取り込む "hajimu_gui" として GUI
変数 アプリ = GUI.アプリ作成("非同期プロセスの回帰テスト", 640, 400)
変数 タスク = -1
変数 通知数 = 0
GUI.描画ループ(アプリ, 関数():
    もし タスク == -1 なら
        タスク = GUI.非同期実行({"実行ファイル": "/bin/sh", "引数": ["-c", "sleep 0.15; exit 7"]}, 無)
        表明(タスク > 0, "プロセスを起動できません")
    終わり
    GUI.テキスト("実行フレーム " + 文字列化(GUI.フレーム数()))
    GUI.タスク通知(タスク, 関数(結果):
        通知数 = 通知数 + 1
        表明(結果["状態"] == "失敗" かつ 結果["終了コード"] == 7, "失敗状態が不正です")
        表明(GUI.フレーム数() > 2, "GUIのフレームが進んでいません")
    終わり)
    もし 通知数 > 0 なら
        表明(通知数 == 1, "完了通知が重複しました")
        表明(GUI.タスク通知(タスク, 関数(結果): 通知数 = 通知数 + 1 終わり) == 偽, "完了を再通知しました")
        表明(GUI.タスク進捗(タスク) == -1, "失敗を進捗100にしました")
        表明(GUI.タスク解放(タスク), "完了タスクを解放できません")
        GUI.アプリ終了(アプリ)
    終わり
    表明(GUI.フレーム数() < 180, "タスク完了を待ち続けています")
終わり)
表明(通知数 == 1, "完了通知がありません")
表示("async process API tests passed")
