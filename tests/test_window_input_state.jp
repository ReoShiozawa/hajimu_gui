取り込む "hajimu_gui" として GUI
変数 左 = GUI.アプリ作成("ウィンドウA", 480, 240)
変数 右 = GUI.アプリ作成("ウィンドウB", 480, 240)
表明(GUI.アプリ入力状態(左)["有効"] かつ GUI.アプリ入力状態(右)["有効"], "入力状態を取得できません")
表明(GUI.アプリ入力状態(左 + 0.5)["有効"] == 偽, "小数IDを受理しました")
変数 左回数 = 0
GUI.描画ループ(左, 関数():
    左回数 = 左回数 + 1
    GUI.テキスト("Aを処理中")
    表明(GUI.アプリ終了状態(右)["状態"] == "実行中", "別のウィンドウを終了しました")
    もし 左回数 >= 3 なら
        GUI.アプリ終了(左)
    終わり
終わり)
変数 右回数 = 0
GUI.描画ループ(右, 関数():
    右回数 = 右回数 + 1
    GUI.テキスト("Bを処理中")
    表明(GUI.アプリ入力状態(右)["入力リセット待ち"] == 偽, "通常入力で上限リセットが発生しました")
    もし 右回数 >= 3 なら
        GUI.アプリ終了(右)
    終わり
終わり)
GUI.アプリ終了(左)
GUI.アプリ終了(右)
表明(GUI.アプリ入力状態(左)["有効"] == 偽, "破棄済みアプリを有効扱いにしました")
表示("window input state API passed")
