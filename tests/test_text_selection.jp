取り込む "hajimu_gui" として GUI
変数 アプリ = GUI.アプリ作成("入力範囲API検査", 640, 400)
変数 検査済み = 偽
GUI.描画ループ(アプリ, 関数():
    GUI.テキスト入力("日本語欄", "a日本b")
    もし 検査済み == 偽 なら
        表明(GUI.テキスト範囲選択("日本語欄", 3, 1), "逆方向の選択ができません")
        表明(GUI.テキストカーソル位置("日本語欄") == 1, "選択末端がカーソルではありません")
        表明(GUI.テキストカーソル位置("日本語欄", 2) == 2, "日本語の文字位置が一致しません")
        表明(GUI.テキストカーソル位置("別の欄") == -1, "別の入力欄と状態を共有しました")
        表明(GUI.テキスト範囲選択("日本語欄", -1, 2) == 偽, "負の位置を受理しました")
        表明(GUI.テキスト検索置換("日本語欄", "日本", "語") == 1, "検索置換が失敗しました")
        表明(GUI.テキストカーソル位置("日本語欄", 20) == 3, "置換後の長さに追従しません")
        検査済み = 真
    それ以外
        GUI.アプリ終了(アプリ)
    終わり
終わり)
表示("text selection API passed")
