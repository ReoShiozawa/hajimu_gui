取り込む "hajimu_gui" として GUI
変数 アプリ = GUI.アプリ作成("内容に合わせたテキスト配置", 640, 400)
GUI.テーマ設定("ライト")
変数 本文 = "日本語の説明文も English text も、同じ幅と行高さで測定・描画します。\r\n末尾の空行も残します。\n"
変数 設定 = {"幅": 360, "サイズ": 20, "行高さ": 30, "色": "#285F9B"}
変数 パス = 環境変数("GUI_TEXT_BLOCK_CAPTURE")
変数 撮影済み = 偽
GUI.描画ループ(アプリ, 関数():
    GUI.テキスト("説明と入力を、重ねずに配置")
    変数 直前 = GUI.ウィジェット矩形()
    変数 寸法 = GUI.テキスト測定(本文, 設定)
    表明(GUI.ウィジェット矩形()["y"] == 直前["y"], "測定で配置が変わりました")
    GUI.折返しテキスト(本文, 設定)
    変数 描画 = GUI.ウィジェット矩形()
    表明(描画["高さ"] == 寸法["高さ"], "測定と描画の高さが違います")
    表明(寸法["高さ"] == 寸法["行数"] * 30, "行高さが一致しません")
    GUI.テキスト入力("作品名", "次の部品は説明の下に配置")
    変数 入力 = GUI.ウィジェット矩形()
    表明(入力["y"] >= 描画["y"] + 描画["高さ"], "説明文と入力欄が重なりました")
    変数 空行 = GUI.テキスト測定("A\r\n\r\n", 設定)
    表明(空行["行数"] == 3, "末尾の空行を数えていません")
    もし GUI.フレーム数() >= 3 なら
        もし パス != 無 かつ パス != "" かつ 撮影済み == 偽 なら
            GUI.スクリーンショット(パス)
            撮影済み = 真
        それ以外
            GUI.アプリ終了(アプリ)
        終わり
    終わり
終わり)
GUI.アプリ終了(アプリ)
表示("text block API passed")
