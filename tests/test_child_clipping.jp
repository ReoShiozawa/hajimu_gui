取り込む "hajimu_gui" として GUI
変数 パス = 環境変数("GUI_LAYOUT_CAPTURE")
表明(パス != 無 かつ パス != "", "キャプチャ先が必要です")
変数 アプリ = GUI.アプリ作成("入れ子クリッピングの検査", 640, 400)
GUI.テーマ設定("ライト")
変数 保存済み = 偽
GUI.描画ループ(アプリ, 関数():
    GUI.子ウィンドウ開始("outer", 180, 100, 偽)
    GUI.子ウィンドウ開始("inner", 300, 250, 偽)
    GUI.ボタン("", {"高さ": 200, "幅": 120, "色": GUI.色(220, 40, 40, 255)})
    GUI.子ウィンドウ終了()
    GUI.子ウィンドウ終了()
    もし 保存済み かつ ファイル存在(パス) なら
        GUI.アプリ終了(アプリ)
    それ以外もし GUI.フレーム数() > 2 かつ 保存済み == 偽 なら
        GUI.スクリーンショット(パス)
        保存済み = 真
    終わり
終わり)
